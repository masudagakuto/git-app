<div class="container" style="margin-top: 20px;">
  <h1>Rootpro CAD解析ツール</h1>
  <p>.rpcdファイルをアップロードすると、AI（llama2）が内容を解析します。</p>

  <div class="health-section" style="border: 1px solid #e0e0e0; padding: 15px; margin: 20px 0; border-radius: 5px; background: #f5f5f5;">
    <h3>Ollama接続確認</h3>
    <button type="button" class="btn btn-secondary" onclick="checkHealth()">接続テスト</button>
    <div id="healthStatus" style="margin-top: 10px;"></div>
  </div>

  <div class="upload-section" style="border: 1px solid #ddd; padding: 20px; margin: 20px 0; border-radius: 5px;">
    <h3>ファイルアップロード</h3>
    <form id="uploadForm" enctype="multipart/form-data">
      <input type="file" id="fileInput" name="file" accept=".rpcd" required>
      <button type="submit" class="btn btn-primary">解析開始</button>
    </form>
  </div>

  <div id="loading" style="display: none; margin: 20px 0;">
    <p>⏳ 解析中です。少々お待ちください...</p>
  </div>

  <div id="result" style="margin: 20px 0;">
    <!-- 結果はここに表示されます -->
  </div>
</div>

<script>
  const form = document.getElementById('uploadForm');
  const fileInput = document.getElementById('fileInput');
  const loading = document.getElementById('loading');
  const result = document.getElementById('result');

  async function checkHealth() {
    const healthStatus = document.getElementById('healthStatus');
    healthStatus.innerHTML = '<p>⏳ 接続確認中...</p>';

    try {
      const response = await fetch('/cad_analyzer/health_check');
      const data = await response.json();

      if (data.status === 'connected') {
        const models = data.models_available.join(', ');
        const llama2Status = data.llama2_available ? '✅' : '⚠️';
        healthStatus.innerHTML = `
          <div style="border: 1px solid #d4edda; background: #d4edda; padding: 15px; border-radius: 5px; color: #155724;">
            <strong>✅ Ollama接続成功</strong>
            <p><strong>ホスト:</strong> ${data.ollama_host}</p>
            <p><strong>利用可能なモデル:</strong> ${models || 'なし'}</p>
            <p><strong>llama2:</strong> ${llama2Status} ${data.llama2_available ? '利用可能' : '未インストール (ollama pull llama2 を実行してください)'}</p>
          </div>
        `;
      } else {
        healthStatus.innerHTML = `
          <div style="border: 1px solid #f5c6cb; background: #f8d7da; padding: 15px; border-radius: 5px; color: #721c24;">
            <strong>❌ エラー:</strong> ${data.message}
          </div>
        `;
      }
    } catch (error) {
      healthStatus.innerHTML = `
        <div style="border: 1px solid #f5c6cb; background: #f8d7da; padding: 15px; border-radius: 5px; color: #721c24;">
          <strong>❌ 通信エラー:</strong> ${error.message}
        </div>
      `;
    }
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const file = fileInput.files[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('file', file);

    loading.style.display = 'block';
    result.innerHTML = '';

    try {
      const response = await fetch('/cad_analyzer/analyze', {
        method: 'POST',
        body: formData,
        headers: {
          'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
        }
      });

      const data = await response.json();

      loading.style.display = 'none';

      if (response.ok) {
        result.innerHTML = `
          <div style="border: 1px solid #d4edda; background: #d4edda; padding: 15px; border-radius: 5px; margin: 10px 0;">
            <h3>ファイル名: ${data.filename}</h3>
          </div>
          <div style="border: 1px solid #ccc; padding: 15px; border-radius: 5px; background: #f9f9f9; white-space: pre-wrap; word-break: break-word;">
            <h4>AI解析結果:</h4>
            ${data.analysis}
          </div>
        `;
      } else {
        result.innerHTML = `
          <div style="border: 1px solid #f5c6cb; background: #f8d7da; padding: 15px; border-radius: 5px; color: #721c24;">
            <strong>エラー:</strong> ${data.error}
          </div>
        `;
      }
    } catch (error) {
      loading.style.display = 'none';
      result.innerHTML = `
        <div style="border: 1px solid #f5c6cb; background: #f8d7da; padding: 15px; border-radius: 5px; color: #721c24;">
          <strong>通信エラー:</strong> ${error.message}
        </div>
      `;
    }
  });
</script>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    font-family: Arial, sans-serif;
  }

  input[type="file"] {
    padding: 8px;
    margin-right: 10px;
  }

  .btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
  }

  .btn-primary {
    background-color: #007bff;
    color: white;
  }

  .btn-primary:hover {
    background-color: #0056b3;
  }

  .btn-secondary {
    background-color: #6c757d;
    color: white;
  }

  .btn-secondary:hover {
    background-color: #5a6268;
  }
</style>
